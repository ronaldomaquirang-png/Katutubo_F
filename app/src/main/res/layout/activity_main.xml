<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Entrance Screen (Overlay) -->
    <LinearLayout
        android:id="@+id/entrance_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F3EF"
        android:padding="24dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/logoooo"
            android:layout_marginBottom="20dp"
            android:contentDescription="Katutubo Logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KATUTUBO"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#4E342E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indigenous Market"
            android:textSize="16sp"
            android:textColor="#6D4C41"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/enterBtn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="ENTER MARKET"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8D6E63"/>

    </LinearLayout>

</RelativeLayout>