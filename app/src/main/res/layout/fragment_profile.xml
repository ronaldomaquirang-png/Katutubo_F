<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/katutubo_brown">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shopee Style Profile Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#EE4D2D">

                <!-- User Info -->
                <LinearLayout
                    android:id="@+id/logged_in_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profile_image"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/logoooo"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            android:padding="2dp"
                            android:background="@color/white"
                            android:scaleType="centerCrop"
                            android:clickable="true"
                            android:focusable="true" />

                        <ImageView
                            android:id="@+id/btn_edit_profile_image"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/badge_bg"
                            android:padding="4dp"
                            android:src="@drawable/ic_edit_24"
                            app:tint="@color/white"
                            android:elevation="4dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Katutubo User"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guest_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_login_profile"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Log In"
                        android:backgroundTint="@color/white"
                        android:textColor="#EE4D2D"
                        android:layout_marginEnd="12dp"
                        android:textAllCaps="false"/>

                    <Button
                        android:id="@+id/btn_signup_profile"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Sign Up"
                        android:backgroundTint="?android:attr/colorBackground"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:alpha="0.8"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- My Purchases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Purchases"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:drawableStart="@android:drawable/ic_menu_view"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/badge_my_purchases"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_toEndOf="@id/dummy_anchor"
                        android:layout_marginStart="-12dp"
                        android:background="@drawable/badge_bg"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:text="@string/default_badge_text"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/dummy_anchor"
                        android:layout_width="100dp"
                        android:layout_height="1dp"
                        android:layout_alignParentStart="true"/>

                    <TextView
                        android:id="@+id/btn_view_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="View Purchase History ›"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <RelativeLayout android:id="@+id/to_pay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_payment_24" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To Pay" android:textSize="11sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/badge_to_pay" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/badge_bg" android:textColor="@color/white" android:textSize="10sp" android:gravity="center" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" android:text="@string/default_badge_text" android:visibility="gone" />
                    </RelativeLayout>

                    <RelativeLayout android:id="@+id/to_ship" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_shipping_24" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To Ship" android:textSize="11sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/badge_to_ship" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/badge_bg" android:textColor="@color/white" android:textSize="10sp" android:gravity="center" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" android:text="@string/default_badge_text" android:visibility="gone" />
                    </RelativeLayout>

                    <RelativeLayout android:id="@+id/to_receive" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_receive_24" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To Receive" android:textSize="11sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/badge_to_receive" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/badge_bg" android:textColor="@color/white" android:textSize="10sp" android:gravity="center" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" android:text="@string/default_badge_text" android:visibility="gone" />
                    </RelativeLayout>

                    <RelativeLayout android:id="@+id/to_rate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star_24" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To Rate" android:textSize="11sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/badge_to_rate" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/badge_bg" android:textColor="@color/white" android:textSize="10sp" android:gravity="center" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" android:text="@string/default_badge_text" android:visibility="gone" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Menu Grid Shopee Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView android:id="@+id/my_favorites" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="My Favorites" android:drawableStart="@android:drawable/ic_menu_save" android:drawablePadding="16dp" android:drawableEnd="@android:drawable/ic_menu_more"/>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EEEEEE" android:layout_marginStart="48dp"/>
                <TextView android:id="@+id/recently_viewed" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Recently Viewed" android:drawableStart="@android:drawable/ic_menu_recent_history" android:drawablePadding="16dp" android:drawableEnd="@android:drawable/ic_menu_more"/>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EEEEEE" android:layout_marginStart="48dp"/>
                <TextView android:id="@+id/my_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="My Account" android:drawableStart="@android:drawable/ic_menu_myplaces" android:drawablePadding="16dp" android:drawableEnd="@android:drawable/ic_menu_more"/>
                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EEEEEE" android:layout_marginStart="48dp"/>
                <TextView android:id="@+id/help_centre" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="@string/help_centre" android:drawableStart="@android:drawable/ic_menu_help" android:drawablePadding="16dp" android:drawableEnd="@android:drawable/ic_menu_more"/>
            </LinearLayout>

            <!-- Promotions Section -->
            <LinearLayout
                android:id="@+id/profile_promo_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tv_btn_special_offers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/special_offers_caps"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="8dp">
                    <LinearLayout
                        android:id="@+id/profile_promo_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Recent Views Section -->
            <LinearLayout
                android:id="@+id/profile_recent_views_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recently_viewed_caps"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="8dp">
                    <LinearLayout
                        android:id="@+id/profile_recent_views_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Recommendations Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommendations_caps"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="8dp">
                    <LinearLayout
                        android:id="@+id/profile_recommendations_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <Button
                android:id="@+id/logout_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/white"
                android:text="Logout"
                android:textColor="#EE4D2D"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        android:elevation="8dp"/>

</RelativeLayout>