<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/katutubo_brown">

    <!-- Sticky Header -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EE4D2D"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_white_bg"
                android:backgroundTint="#F5F5F5">

                <ImageView
                    android:id="@+id/search_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#EE4D2D" />

                <EditText
                    android:id="@+id/SearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/search_icon"
                    android:layout_toStartOf="@id/camera_search_container"
                    android:background="@null"
                    android:hint="Search Katutubo Marketplace"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColorHint="#999999"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/camera_search_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:background="#DDDDDD"
                        android:layout_marginEnd="8dp"/>

                    <ImageView
                        android:id="@+id/btn_camera_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#EE4D2D"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/home_header"
        android:layout_above="@id/bottom_navigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:gravity="center_vertical">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp">

                        <TextView android:id="@+id/category_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All" android:textColor="#EE4D2D" android:textStyle="bold" android:paddingHorizontal="16dp" android:textSize="14sp" />
                        <TextView android:id="@+id/category_crafts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crafts" android:textColor="#333333" android:paddingHorizontal="16dp" android:textSize="14sp" />
                        <TextView android:id="@+id/category_clothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clothing" android:textColor="#333333" android:paddingHorizontal="16dp" android:textSize="14sp" />
                        <TextView android:id="@+id/category_accessories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accessories" android:textColor="#333333" android:paddingHorizontal="16dp" android:textSize="14sp" />
                        <TextView android:id="@+id/category_home_decor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home Decor" android:textColor="#333333" android:paddingHorizontal="16dp" android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/btn_search_categories"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#888888"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Special Offers Banner Slider -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/banner_card"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="12dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/banner_viewpager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/banner_indicator"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="8dp"
                        android:background="@android:color/transparent"
                        app:tabBackground="@drawable/indicator_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabMaxWidth="12dp"
                        app:tabRippleColor="@null" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Flash Sale Section -->
            <LinearLayout
                android:id="@+id/flash_sale_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:layout_marginTop="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLASH SALE"
                            android:textColor="#EE4D2D"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_see_all_sale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="See All ›"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="6dp">
                    <LinearLayout
                        android:id="@+id/discounted_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Categories Grid (Hot Picks) -->
            <LinearLayout
                android:id="@+id/hot_picks_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORIES"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="8dp"/>

                <GridLayout
                    android:id="@+id/hot_picks_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <!-- Daily Discover (Product List) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center"
                    android:paddingVertical="12dp">
                    <View android:layout_width="40dp" android:layout_height="1dp" android:background="#DDDDDD"/>
                    <TextView
                        android:id="@+id/tv_discover_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="DAILY DISCOVER"
                        android:textColor="#EE4D2D"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <View android:layout_width="40dp" android:layout_height="1dp" android:background="#DDDDDD"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/product_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        android:elevation="8dp"/>

</RelativeLayout>